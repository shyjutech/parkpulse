NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# AI mock interview (/interview). Server-only -- never prefix with NEXT_PUBLIC_.
# Provider-neutral: any OpenAI-compatible chat-completions endpoint works.
# Required: the route fails clearly, without calling the provider, if any of
# these three is unset. For OpenRouter, AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional, default 6 if unset.
AI_INTERVIEW_MAX_QUESTIONS=
